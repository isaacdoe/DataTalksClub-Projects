# Copy this file to .env and fill in your keys
# docker-compose will automatically load these

# --- LLM Provider (pick one, set LLM_PROVIDER below) ---
# openrouter = free, less reliable (default)
# deepseek   = paid, ~$0.27/M tokens

# === OpenRouter (get key: https://openrouter.ai/keys) ===
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# === DeepSeek (get key: https://platform.deepseek.com/api_keys) ===
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# === Provider selection (uncomment and set one) ===
LLM_PROVIDER=openrouter
# LLM_PROVIDER=deepseek

# === GitHub ===
MY_GITHUB_TOKEN=your_github_personal_access_token

# === Optional ===
# OPENAI_API_KEY=your_openai_api_key_here
# CSV_PATH=./Data/dezoomcamp/2024/cleaned_scraped_dezoomcamp_2024_1.csv
